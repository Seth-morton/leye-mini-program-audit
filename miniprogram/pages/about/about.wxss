page{background:#F7F5F0;color:#172433}
.page{padding:48rpx 0 calc(60rpx + env(safe-area-inset-bottom))}
.brand-mark{text-align:center;font-size:68rpx;font-weight:650;letter-spacing:8rpx;padding-top:36rpx}
.brand-en{text-align:center;font-size:19rpx;letter-spacing:7rpx;color:#87919A;margin:12rpx 0 40rpx}
.card{background:#fff;border-radius:20rpx;margin:24rpx 32rpx 0;padding:32rpx}
.card-title{font-size:32rpx;font-weight:600;color:#172433}
.card-body{margin-top:16rpx;font-size:26rpx;line-height:1.9;color:#52606C}
.service-row{display:flex;justify-content:space-between;align-items:center;padding:22rpx 0;border-bottom:1rpx solid #EEF0F2;font-size:26rpx}
.service-row:last-child{border-bottom:0}
.service-row text:last-child{font-size:22rpx;color:#87919A}
.contact-note{margin:32rpx 44rpx 0;font-size:23rpx;line-height:1.8;color:#87919A;text-align:center}
.footer{text-align:center;padding:48rpx 32rpx 0;font-size:22rpx;color:#AAB2B9}
