<view class="page">
  <view class="profile"><view class="avatar">乐</view><view class="profile-info"><view class="profile-name">{{profile.displayName||'乐也家长'}}</view><view class="profile-sub">{{profile.phone||'尚未验证手机号'}}</view></view></view>
  <view wx:if="{{!profile.phone}}" class="card"><view class="menu-title">完成手机号验证</view><view class="muted">手机号用于匹配工作室已建立的家庭档案。验证后仍需负责人审核家庭关联。</view><button open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">微信手机号验证</button></view>
  <view class="menu" bindtap="goNotifications">通知中心 <text>›</text></view><view class="menu" bindtap="goAbout">关于乐也 <text>›</text></view><view class="menu" bindtap="logout">退出登录 <text>›</text></view>
  <view class="footer">乐也声乐工作室</view>
</view>