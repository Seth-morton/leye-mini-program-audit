<view class="page"><view wx:if="{{rows.length}}" class="card"><view wx:for="{{rows}}" wx:key="id" class="item"><view class="title">{{item.title}}</view><view class="body">{{item.body}}</view><view class="muted">{{item.createdAt}}</view><button wx:if="{{!item.readAt}}" size="mini" data-id="{{item.id}}" bindtap="markRead">标记已读</button></view></view><view wx:else class="card muted">暂无通知。</view></view>