<view class="page">
  <view class="hero"><view class="eyebrow">LEYE MUSIC STUDIO</view><view class="hero-title">让每一份声音，<br/>都被认真听见。</view><view class="hero-sub">乐也声乐工作室 · 学习服务中心</view></view>
  <view wx:if="{{loading}}" class="card muted">正在加载家庭信息…</view>
  <view wx:elif="{{needsBinding}}" class="card"><view class="section-title">{{phoneVerified?"等待家庭关联审核":"绑定家庭账号"}}</view><view class="muted">{{phoneVerified?"手机号已验证。工作室负责人审核家庭关联后，孩子的课表和学习信息会显示在这里。":"请先完成微信手机号验证。若尚未由工作室建立家庭档案，请联系负责人。"}}</view><button wx:if="{{!phoneVerified}}" class="primary" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">验证手机号并绑定</button><view wx:if="{{error}}" class="muted">{{error}}</view></view>
  <view wx:else class="card"><view class="row"><view class="section-title">我的孩子</view><picker wx:if="{{students.length>1}}" range="{{students}}" range-key="name" value="{{studentIndex}}" bindchange="chooseStudent"><view class="switch">切换孩子 ▾</view></picker></view><view class="student-name">{{studentName}}</view><view class="muted">当前查看孩子的课程与学习信息</view></view>
  <view class="row section"><view class="section-title">近期课程</view><view class="switch" bindtap="openNotifications">通知中心 ›</view></view>
  <view wx:if="{{lessons.length}}" class="card"><view wx:for="{{lessons}}" wx:key="id" class="lesson-row"><view class="lesson-name">{{item.courseName}}</view><view class="muted">{{item.startsAtLocal}} · {{item.teacherName}} · {{item.roomName}}</view></view></view>
  <view wx:else class="card muted">暂无近期课程安排。</view>
  <view class="card about" bindtap="openAbout"><view class="section-title">关于乐也</view><view class="muted">专业声乐教学 · 艺考指导 · 钢琴辅助</view></view>
</view>