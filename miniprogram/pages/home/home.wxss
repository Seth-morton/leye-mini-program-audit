page{background:#f4f5f6}.page{padding:24rpx 28rpx calc(110rpx + env(safe-area-inset-bottom))}.hero{background:#172433;color:#fff;border-radius:24rpx;padding:38rpx 32rpx;margin-bottom:22rpx}.eyebrow{font-size:20rpx;letter-spacing:4rpx;color:#c6d0d8}.hero-title{font-size:46rpx;line-height:1.5;font-weight:600;margin:20rpx 0}.hero-sub{font-size:24rpx;color:#d5dce3}.card{background:#fff;border-radius:18rpx;padding:28rpx;margin:18rpx 0}.row{display:flex;justify-content:space-between;align-items:center}.section-title{font-size:30rpx;font-weight:600;color:#172433}.student-name{font-size:40rpx;font-weight:600;margin:24rpx 0 8rpx}.muted{font-size:24rpx;color:#87919a;line-height:1.7}.switch{font-size:24rpx;color:#52677a}.primary{background:#172433;color:#fff;border-radius:12rpx;margin-top:24rpx;font-size:28rpx}.lesson-row{padding:16rpx 0;border-bottom:1rpx solid #eef0f2}.lesson-row:last-child{border:0}.lesson-name{font-size:28rpx;font-weight:600}.about{margin-top:28rpx}