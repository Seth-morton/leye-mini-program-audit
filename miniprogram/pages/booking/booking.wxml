<view class="page">
  <view class="title">预约试听</view>
  <view class="muted intro">留下意向信息，工作室将联系您确认。</view>

  <van-cell-group inset custom-class="form-group">
    <picker range="{{courseNames}}" value="{{courseIndex}}" bindchange="chooseCourse">
      <van-field label="课程" readonly is-link value="{{courseNames[courseIndex]}}" placeholder="请选择课程" />
    </picker>
    <van-field label="姓名" placeholder="请输入学员姓名" value="{{studentName}}" bind:change="onStudentName" />
    <van-field label="家长姓名" placeholder="选填" value="{{guardianName}}" bind:change="onGuardianName" />
    <van-field label="手机号" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bind:change="onPhone" />
    <picker mode="date" value="{{preferredDate}}" start="{{today}}" bindchange="chooseDate">
      <van-field label="意向日期" readonly is-link value="{{preferredDate}}" placeholder="选填" />
    </picker>
    <picker mode="time" value="{{preferredTime}}" bindchange="chooseTime">
      <van-field label="意向时间" readonly is-link value="{{preferredTime}}" placeholder="选填" />
    </picker>
    <van-field label="备注" type="textarea" autosize maxlength="500" placeholder="有特殊要求可以备注" value="{{note}}" bind:change="onNote" border="{{false}}" />
  </van-cell-group>

  <view class="submit-wrap">
    <van-button type="primary" block round loading="{{submitting}}" disabled="{{submitting}}" custom-class="submit-btn" bind:click="submit">提交预约</van-button>
  </view>

  <view class="muted privacy">提交后，工作室将通过电话与您联系确认。请勿填写无关敏感信息。</view>
</view>
