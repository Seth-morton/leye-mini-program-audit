<view class="page"><view class="card row"><view><view class="title">{{studentName||'课表'}}</view><view class="muted">课程安排</view></view><picker wx:if="{{students.length>1}}" range="{{students}}" range-key="name" value="{{studentIndex}}" bindchange="chooseStudent"><view class="switch">切换孩子 ▾</view></picker></view><view wx:if="{{loading}}" class="muted">加载中…</view><view wx:elif="{{rows.length}}" class="card"><view wx:for="{{rows}}" wx:key="id" class="item"><view class="title">{{item.courseName}}</view><view class="muted">{{item.startsAtUtc}} – {{item.endsAtUtc}}</view><view class="muted">{{item.teacherName}} · {{item.roomName}}</view><view class="tag">{{item.status==='completed'?'已完成':'已安排'}}</view></view></view><view wx:else class="card muted">暂时没有课程安排。</view></view>