<view class="page"><view class="card row"><view class="title">{{studentName||'成长记录'}}</view><picker wx:if="{{students.length>1}}" range="{{students}}" range-key="name" value="{{studentIndex}}" bindchange="chooseStudent"><view class="switch">切换孩子 ▾</view></picker></view><view wx:if="{{rows.length}}" class="card"><view wx:for="{{rows}}" wx:key="id" class="item"><view class="title">课堂记录</view><view class="muted">{{item.publishedAt}}</view><view class="body">{{item.summary}}</view><view wx:if="{{item.practiceTasks}}" class="task">练习任务：{{item.practiceTasks}}</view></view></view><view wx:else class="card muted">老师发布成长记录后，会显示在这里。</view></view>