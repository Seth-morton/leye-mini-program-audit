<view class="page">
  <van-loading wx:if="{{loading}}" class="loading" color="#007aff" />

  <block wx:elif="{{list.length}}">
    <van-cell-group inset custom-class="list-group">
      <van-cell wx:for="{{list}}" wx:key="id">
        <view slot="title" class="item">
          <view class="item-head">
            <text class="course">{{item.courseName}}</text>
            <van-tag wx:if="{{item.status === 'pending'}}" type="warning">待确认</van-tag>
            <van-tag wx:elif="{{item.status === 'confirmed'}}" type="success">已确认</van-tag>
            <van-tag wx:elif="{{item.status === 'declined'}}" type="danger">已拒绝</van-tag>
            <van-tag wx:elif="{{item.status === 'completed'}}" type="primary">已完成</van-tag>
          </view>
          <view class="line">意向时间：{{item.timeText}}</view>
          <view class="line">提交时间：{{item.createdAt}}</view>
        </view>
      </van-cell>
    </van-cell-group>
  </block>

  <van-empty wx:else description="{{hasPhone ? '您还没有预约记录' : '未找到预约记录，请先提交一次预约'}}" />
</view>
